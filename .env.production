# Hostinger Production Environment Template
APP_NAME="Barangay Pili Clearance"
APP_ENV=production
APP_KEY=base64:YME2CxoCQJbil/UQkig1vZARhhdFoXrKfFMJU6MDMZQ=
APP_DEBUG=false
APP_URL=https://brgypilieclearance.com
JWT_SECRET=REPLACE_WITH_STRONG_32_CHAR_RANDOM_SECRET_FOR_PRODUCTION

# Admin Portal Subdomain
ADMIN_DOMAIN=admin.brgypilieclearance.com

# Google reCAPTCHA v2 (Set your production keys from google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL Database Credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_brgy_pili
DB_USERNAME=u123456789_brgy_user
DB_PASSWORD=YOUR_HOSTINGER_DB_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional Mail SMTP settings (Hostinger Webmail / Gmail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@brgypilieclearance.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@brgypilieclearance.com
MAIL_FROM_NAME="${APP_NAME}"

# PhilSMS SMS Gateway (https://philsms.com)
# Set these in Hostinger's environment variable panel
PHILSMS_ENABLED=true
PHILSMS_API_TOKEN=your_philsms_token_here
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send
PHILSMS_SENDER_ID=PhilSMS
