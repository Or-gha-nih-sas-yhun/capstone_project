APP_NAME="Barangay Clearance System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Barangay deployment ──────────────────────────────────────────────────
# The barangay's name, municipality, province, seals, fees and puroks are
# NOT configured here. Run `php artisan barangay:setup` after migrating, or
# edit them in Admin -> Barangay Settings. Only values needed before the
# database is available live in this file.

# Admin portal subdomain. Defaults to "admin." + the host in APP_URL.
ADMIN_DOMAIN=

# Public domain without scheme, used for Content-Security-Policy and the
# default no-reply address. Defaults to the host in APP_URL.
APP_DOMAIN=

# Token the Android resident app appends to its User-Agent. Must match
# brgyUaToken in resident-mobile-app/gradle.properties. The legacy value
# "BrgyPiliApp" is always accepted as well.
MOBILE_UA_TOKEN=BrgyPortalApp

# Secret for the /run-migrations endpoint. Leave BLANK to disable that
# route entirely, which is the right choice unless you are mid-deploy on a
# host without shell access.
MIGRATION_KEY=

# Google reCAPTCHA v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PhilSMS SMS Gateway (https://philsms.com)
# Get your token from: https://dashboard.philsms.com/api
PHILSMS_ENABLED=true
PHILSMS_API_TOKEN=your_philsms_token_here
PHILSMS_API_URL=https://dashboard.philsms.com/api/v3/sms/send
PHILSMS_SENDER_ID=PhilSMS
